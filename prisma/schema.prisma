// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime?
  image               String?
  password            String?
  role                String    @default("Staff") // "Admin" or "Staff"
  disabled            Boolean   @default(false)
  loginCount          Int       @default(0)
  lastLogin           DateTime?
  lastActivity        DateTime?
  mustChangePassword  Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  accounts            Account[]
  sessions            Session[]
  courierEntries      CourierEntry[]
  courierRegisters    CourierRegister[]
  billingParties      BillingParty[]
  invoices            Invoice[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CourierEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  srNo        Int?     // Auto-generated conceptually or tracked 
  date        DateTime @default(now())
  challanNo   Int
  fromParty   String
  toParty     String
  weightValue Float
  weightUnit  String   @default("gm")
  destination String
  amount      Float
  status      String   // Cash, Account, Pending, Delivered
  mode        String?  @default("Surface") // Surface, Air, Cargo, V Fast
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  registerId  String?
  register    CourierRegister? @relation(fields: [registerId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([challanNo, userId])
  @@index([userId, fromParty])
  @@index([userId, toParty])
  @@index([userId, destination])
}

model CourierRegister {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  month          Int            // 1-12
  year           Int
  status         String         @default("Active") // "Active", "Locked", "Archived"
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  courierEntries CourierEntry[]

  @@unique([userId, name])
}

model SystemSettings {
  id             String   @id @default("global")
  companyName    String   @default("HemTej Co")
  companyLogo    String   @default("/icon.png")
  companyAddress String   @default("")
  companyPhone   String   @default("")
  companyEmail   String   @default("")
  companyGst     String   @default("")
  defaultStatus  String   @default("Cash")
  invoiceTerms   String?  @default("Payment due within 15 days from invoice date. Goods once dispatched will not be returned.")
  manifestTerms  String?  @default("Subject to local jurisdiction. Handle package with care.")
  lastBillNo     Int      @default(100)
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  adminName String
  action    String
  entity    String
  entityId  String
  oldValue  String?
  newValue  String?
  timestamp DateTime @default(now())

  @@index([oldValue, action])
}

model BillingParty {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aliases             String[]
  officialInvoiceName String
  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  pincode             String?
  contactNumber       String?
  gstNumber           String?
  isArchived          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  invoices            Invoice[]

  @@unique([userId, officialInvoiceName])
  @@index([userId])
}

model Invoice {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  billNo           String?  @unique
  invoiceDate      DateTime
  billingFromDate  DateTime?
  billingToDate    DateTime?
  billingPartyNames String[]
  status           String   @default("ACTIVE")
  partyId          String?
  party            BillingParty? @relation(fields: [partyId], references: [id], onDelete: SetNull)
  partySnapshot    Json
  businessSnapshot Json?
  entriesCount     Int      @default(0)
  grossAmount      Float    @default(0)
  cgst             Float    @default(0)
  sgst             Float    @default(0)
  igst             Float    @default(0)
  netAmount        Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  courierEntries   CourierEntry[]
}
